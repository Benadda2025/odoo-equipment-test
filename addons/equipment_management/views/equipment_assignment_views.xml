<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="assignment_view_list" model="ir.ui.view">
        <field name="name">equipment.assignment.list</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <list
                decoration-info="is_active"
                decoration-muted="not is_active"
                sample="1"
            >
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="note" optional="hide"/>

                <field name="is_active" column_invisible="1"/>

                <button
                    name="action_return"
                    type="object"
                    string="Return"
                    icon="fa-undo"
                    invisible="not is_active"
                />
            </list>
        </field>
    </record>


    <!-- FORM -->
    <record id="assignment_view_form" model="ir.ui.view">
        <field name="name">equipment.assignment.form</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">

            <form>
                <header>
                    <button
                        name="action_return"
                        string="Return Equipment"
                        type="object"
                        class="btn-primary"
                        invisible="not is_active or not id"
                    />
                </header>

                <sheet>

                    <field name="is_active" invisible="1"/>

                    <widget
                        name="web_ribbon"
                        title="Returned"
                        bg_color="text-bg-secondary"
                        invisible="is_active or not id"
                    />

                    <group>

                        <group string="Assignment">
                            <field
                                name="equipment_id"
                                readonly="id"
                                domain="[('state', '=', 'available')]"
                                options="{
                                    'no_create': True,
                                    'no_open': True
                                }"
                            />

                            <field
                                name="employee_id"
                                readonly="id"
                                options="{'no_create': True}"
                            />
                        </group>

                        <group string="Dates">
                            <field
                                name="date_from"
                                readonly="id"
                            />

                            <field
                                name="date_to"
                                invisible="not id"
                            />
                        </group>

                    </group>

                    <notebook>
                        <page string="Notes" name="notes">
                            <field
                                name="note"
                                placeholder="Condition, accessories given..."
                            />
                        </page>
                    </notebook>

                </sheet>
            </form>

        </field>
    </record>


    <!-- SEARCH -->
    <record id="assignment_view_search" model="ir.ui.view">
        <field name="name">equipment.assignment.search</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">

            <search>

                <field
                    name="equipment_id"
                    filter_domain="[
                        '|',
                        ('equipment_id.name', 'ilike', self),
                        ('equipment_id.code', 'ilike', self)
                    ]"
                />

                <field name="employee_id"/>

                <separator/>

                <filter
                    name="active_now"
                    string="In Progress"
                    domain="[('is_active', '=', True)]"
                />

                <filter
                    name="returned"
                    string="Returned"
                    domain="[('is_active', '=', False)]"
                />

                <separator/>

                <filter
                    name="date_from_filter"
                    string="Given Date"
                    date="date_from"
                />

                <group expand="0" string="Group By">

                    <filter
                        name="group_employee"
                        string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />

                    <filter
                        name="group_equipment"
                        string="Equipment"
                        context="{'group_by': 'equipment_id'}"
                    />

                    <filter
                        name="group_month"
                        string="Given Month"
                        context="{'group_by': 'date_from:month'}"
                    />

                </group>

            </search>

        </field>
    </record>


   <!-- CURRENT ASSIGNMENTS -->
<record id="assignment_action_current" model="ir.actions.act_window">
    <field name="name">Current Assignments</field>
    <field name="res_model">equipment.assignment</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active_now': 1}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            No equipment is currently assigned
        </p>
        <p>
            Click New to give equipment to an employee.
        </p>
    </field>
</record>

<!-- ASSIGNMENT HISTORY -->
<record id="assignment_action_history" model="ir.actions.act_window">
    <field name="name">Assignment History</field>
    <field name="res_model">equipment.assignment</field>
    <field name="view_mode">list,form</field>
</record>

</odoo>