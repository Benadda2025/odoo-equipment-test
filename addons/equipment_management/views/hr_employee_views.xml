<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_equipment" model="ir.ui.view">
        <field name="name">hr.employee.form.equipment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_equipment" type="object"
                        class="oe_stat_button" icon="fa-laptop">
                    <field name="equipment_count" widget="statinfo" string="Equipment"/>
                </button>
            </div>
        </field>
    </record>
</odoo>